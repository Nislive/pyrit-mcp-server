# Copy to `.env` and fill in your own values. NEVER commit the real .env.

# OpenAI-compatible API key for LLM targets (victim / adversarial / scorer)
OPENAI_API_KEY=sk-...

# Optional: separate key if you use a different OpenAI-compatible chat endpoint
OPENAI_CHAT_KEY=

# Optional: Groq API key (OpenAI-compatible endpoint)
GROQ_API_KEY=

# Optional: LangSmith tracing (only if you wire this server into a LangGraph host)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pyrit-mcp-server
